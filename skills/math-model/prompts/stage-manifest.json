{
  "schema": "v1",
  "perQuestionStages": [
    "literature",
    "data",
    "assumption",
    "formulation",
    "implementation",
    "computation",
    "sanity",
    "visualization",
    "robustness",
    "localComplete"
  ],
  "runLevelStages": [
    "crossReview",
    "writing",
    "finalReview"
  ],
  "prompts": {
    "literature": "phase-01-literature.md",
    "data": "phase-02-data.md",
    "assumption": "phase-03-assumption.md",
    "formulation": "phase-04-formulation.md",
    "implementation": "phase-05-implementation.md",
    "computation": "phase-06-computation.md",
    "sanity": "phase-07-sanity.md",
    "visualization": "phase-08-visualization.md",
    "robustness": "phase-09-robustness.md",
    "localComplete": "phase-10-localComplete.md",
    "crossReview": "phase-11-crossReview.md",
    "writing": "phase-12-writing.md",
    "finalReview": "phase-13-finalReview.md"
  },
  "retryPolicy": {
    "stageAttempts": 2,
    "formulationRounds": {"full": 3, "quick": 2},
    "assumptionVersions": 5,
    "repairRounds": {"full": 3, "quick": 1},
    "crossReviewRounds": {"full": 3, "quick": 1},
    "_note": "壳强制的只有 stageAttempts 与 formulationRounds；其余三条当前由该阶段在单次调用内自行控制，改这里即改口径"
  },
  "deps": {
    "literature": [
      "00-problem.json",
      "pool/literature-pool.md"
    ],
    "data": [
      "00-problem.json",
      "{id}/01-literature/literature.md"
    ],
    "assumption": [
      "00-problem.json",
      "{id}/01-literature/literature.md",
      "{id}/02-data/eda.md"
    ],
    "formulation": [
      "00-problem.json",
      "{id}/02-data/eda.md",
      "{id}/03-assumptions/"
    ],
    "implementation": [
      "00-problem.json",
      "{id}/04-formulation/draft.md",
      "{id}/04-formulation/baseline-registry.md",
      "{id}/04-formulation/symbols.json",
      "{id}/04-formulation/handoff.md",
      "{id}/02-data/eda.md"
    ],
    "computation": [
      "{id}/05-implementation/code/",
      "{id}/04-formulation/draft.md",
      "{id}/04-formulation/baseline-registry.md",
      "{id}/04-formulation/symbols.json",
      "{id}/04-formulation/handoff.md",
      "{id}/04-formulation/errata.md"
    ],
    "sanity": [
      "00-problem.json",
      "{id}/06-computation/results.json",
      "{id}/04-formulation/draft.md",
      "{id}/04-formulation/symbols.json",
      "{id}/04-formulation/handoff.md",
      "{id}/04-formulation/verification.md",
      "{id}/04-formulation/errata.md"
    ],
    "visualization": [
      "00-problem.json",
      "{id}/06-computation/results.json",
      "{id}/04-formulation/symbols.json",
      "{id}/07-sanity/sanity-report.md"
    ],
    "robustness": [
      "00-problem.json",
      "{id}/06-computation/results.json",
      "{id}/04-formulation/draft.md",
      "{id}/04-formulation/handoff.md",
      "{id}/07-sanity/sanity-report.md"
    ],
    "localComplete": [
      "本问 01–09 全部阶段产物"
    ],
    "crossReview": [
      "全部小问的 10-completed"
    ],
    "writing": [
      "全部产物"
    ],
    "finalReview": [
      "12-writing",
      "全部产物"
    ]
  },
  "gates": [
    {
      "before": "implementation",
      "boundary": "solve-start",
      "check": "该问 04-formulation 产物存在且 state.gates[该问.formulation]=PASS"
    },
    {
      "before": "writing",
      "boundary": "write-start",
      "check": "所有小问 localComplete 且 crossReview ∈ {PASS, PASS_WITH_WARNING}"
    },
    {
      "before": "finalReview",
      "boundary": "final-start",
      "check": "writing 产物完整"
    }
  ],
  "outputLayout": {
    "literature": "{id}/01-literature/literature.md",
    "data": "{id}/02-data/eda.md",
    "assumption": "{id}/03-assumptions/",
    "formulation": "{id}/04-formulation/draft.md",
    "implementation": "{id}/05-implementation/code/",
    "computation": "{id}/06-computation/results.json",
    "sanity": "{id}/07-sanity/sanity-report.md",
    "visualization": "{id}/08-visualization/figure-manifest.md",
    "robustness": "{id}/09-robustness/robustness.md",
    "localComplete": "{id}/10-completed/question-summary.md",
    "crossReview": "11-cross-review/cross-question-report.md",
    "writing": "12-writing/paper-sections/",
    "finalReview": "13-final/final-paper.tex"
  }
}
