  "cards": [
    {
      "dot": "cyan",
      "title": "信息如何传递",
      "items": [
        "壳无文件权限：一切经子代理，文件是唯一通道",
        "统一节拍：读状态→读依赖→执行→写产物→返回摘要",
        "返回契约 {status, artifact_path, summary}，壳据此校验路由"
      ]
    },
    {
      "dot": "emerald",
      "title": "信息如何共享",
      "items": [
        "文档即共享：磁盘产物是唯一权威，下游只读依赖文件",
        "state.json 记位置/门禁/迭代；ledger 追加式日志供溯源",
        "pool/ 文献池与外部数据跨问复用；symbols 统一全局符号"
      ]
    },
    {
      "dot": "rose",
      "title": "错误如何处理",
      "items": [
        "三处门禁：求解前/写作前/终审前，不满足即 blocked",
        "失败收敛：同根因 2 次→换策略或降级 SKIPPED",
        "评审有界回环（≤3 轮）；中断后按 problemId resume"
      ]
    }
  ]
